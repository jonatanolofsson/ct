{
  "//": "Starting-point permissions for Claude Code in a ct workspace. The split is read-vs-mutate: reads are allowed, mutations ask. Every rule is doubled for `direnv exec .` because nix-flake repos run tools through direnv. Copy to ~/.claude/settings.json and add your own path grants (Edit/Write/Read roots, permissions.additionalDirectories) — deliberately not included here.",
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Bash(kubectl get:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl auth can-i:*)",
      "Bash(kubectl rollout status:*)",
      "Bash(kubectl rollout history:*)",
      "Bash(kubectl kustomize:*)",
      "Bash(kubectl config current-context:*)",
      "Bash(kubectl config view:*)",
      "Bash(kubectl config get-contexts:*)",
      "Bash(kubectl version:*)",
      "Bash(kubectl top:*)",
      "Bash(direnv exec . kubectl get:*)",
      "Bash(direnv exec . kubectl logs:*)",
      "Bash(direnv exec . kubectl describe:*)",
      "Bash(direnv exec . kubectl auth can-i:*)",
      "Bash(direnv exec . kubectl rollout status:*)",
      "Bash(direnv exec . kubectl rollout history:*)",
      "Bash(direnv exec . kubectl kustomize:*)",
      "Bash(direnv exec . kubectl config current-context:*)",
      "Bash(direnv exec . kubectl config view:*)",
      "Bash(direnv exec . kubectl version:*)",
      "Bash(helm template:*)",
      "Bash(helm lint:*)",
      "Bash(direnv exec . helm template:*)",
      "Bash(direnv exec . helm lint:*)",
      "Bash(systemctl is-active:*)",
      "Bash(systemctl is-enabled:*)",
      "Bash(systemctl status:*)",
      "Bash(git add *)"
    ],
    "deny": [
      "Bash(rm -rf /*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(kill*)",
      "Bash(pkill*)",
      "Bash(reboot*)",
      "Bash(shutdown*)",
      "Bash(systemctl restart*)",
      "Bash(systemctl stop*)",
      "Bash(systemctl enable*)",
      "Bash(systemctl disable*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl edit*)",
      "Bash(kubectl scale*)",
      "Bash(kubectl cordon*)",
      "Bash(kubectl drain*)",
      "Bash(kubectl taint*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm uninstall*)",
      "Bash(helm rollback*)",
      "Bash(direnv exec*rm *)",
      "Bash(direnv exec*git push --force*)",
      "Bash(direnv exec*git reset --hard*)",
      "Bash(direnv exec*git checkout -- *)",
      "Bash(direnv exec*git clean*)",
      "Bash(direnv exec*git branch -D*)",
      "Bash(direnv exec*kubectl apply*)",
      "Bash(direnv exec*kubectl delete*)",
      "Bash(direnv exec*kubectl patch*)",
      "Bash(direnv exec*kubectl edit*)",
      "Bash(direnv exec*kubectl scale*)",
      "Bash(direnv exec*kubectl cordon*)",
      "Bash(direnv exec*kubectl drain*)",
      "Bash(direnv exec*kubectl taint*)",
      "Bash(direnv exec*helm install*)",
      "Bash(direnv exec*helm upgrade*)",
      "Bash(direnv exec*helm uninstall*)",
      "Bash(direnv exec*helm rollback*)"
    ],
    "defaultMode": "auto"
  }
}
