#!/usr/bin/env bash
# ensure-nix — install nix and start its daemon if absent. Idempotent.
#
# /nix may live on a persistent volume while /etc does not (the edgelab
# code-server chart mounts it from the home PVC when persistNix is set). Then a
# pod restart keeps the store and its database but loses what the installer put
# outside /nix: /etc/nix (nix.conf: flakes, substituters) and the nixbld group
# and build users. A copy kept under /nix puts them back, so a restart costs
# seconds instead of a reinstall and every flake shell rebuilding. Without a
# persistent /nix the copy simply goes with the store, and nothing changes.
set -uo pipefail
log() { printf '%s ensure-nix: %s\n' "$(date -Is)" "$*"; }
NIX_ROOT="${ENSURE_NIX_ROOT:-/nix}"   # overridable for the tests only
ETC="${ENSURE_NIX_ETC:-/etc}"
PROFILE="$NIX_ROOT/var/nix/profiles/default"
KEEP="$NIX_ROOT/.ensure-nix"

# Put back what the installer wrote outside /nix, from the copy under $KEEP.
# Never overwrites: an /etc that already has it is left alone.
restore_etc() {
  if [[ ! -e "$ETC/nix/nix.conf" && -d "$KEEP/etc-nix" ]]; then
    sudo mkdir -p "$ETC/nix" && sudo cp -a "$KEEP/etc-nix/." "$ETC/nix/" \
      && log "restored $ETC/nix from $KEEP"
  fi
  if ! grep -q '^nixbld:' "$ETC/group" 2>/dev/null && [[ -s "$KEEP/group" ]]; then
    local f
    for f in group passwd shadow; do
      [[ -s "$KEEP/$f" ]] && sudo sh -c "cat '$KEEP/$f' >> '$ETC/$f'"
    done
    log "restored the nixbld group and build users"
  fi
}

# Copy that state under $KEEP for the next restart: once, or again after a fresh
# install (which may have changed it). Only when /etc has all of it.
keep_etc() {
  local fresh="$1"
  [[ -e "$ETC/nix/nix.conf" ]] && grep -q '^nixbld:' "$ETC/group" 2>/dev/null || return 0
  [[ -s "$KEEP/group" && -z "$fresh" ]] && return 0
  sudo mkdir -p "$KEEP/etc-nix" && sudo cp -a "$ETC/nix/." "$KEEP/etc-nix/"
  grep '^nixbld:' "$ETC/group" | sudo tee "$KEEP/group" >/dev/null
  grep '^nixbld[0-9]*:' "$ETC/passwd" | sudo tee "$KEEP/passwd" >/dev/null
  sudo grep '^nixbld[0-9]*:' "$ETC/shadow" 2>/dev/null | sudo tee "$KEEP/shadow" >/dev/null
  log "kept $ETC/nix and the build users under $KEEP for the next restart"
}

fresh=""
if [[ -x "$PROFILE/bin/nix" ]]; then
  restore_etc
else
  log "no nix store — installing"
  if timeout 300 curl -fsSL https://install.determinate.systems/nix -o /tmp/nix-install.sh; then
    timeout 900 sudo sh /tmp/nix-install.sh install linux --no-confirm --init none 2>&1 \
      | tail -5 | sed 's/^/    /'
    fresh=1
  else
    log "installer download failed — nix unavailable this boot"
  fi
fi
[[ -x "$PROFILE/bin/nix" ]] || { log "nix still missing, giving up"; exit 1; }
keep_etc "$fresh"
# A mount point kubelet created for /nix can come up 0750; the coder user must
# be able to traverse it to reach its profile and the store.
sudo chmod 0755 "$NIX_ROOT"

# No systemd, so the daemon is ours to start. Same call .bashrc makes for
# interactive shells; done here too because a tmux pane running claude
# directly never sources .bashrc.
if ! pgrep -x nix-daemon >/dev/null 2>&1; then
  sudo sh -c "nohup $PROFILE/bin/nix-daemon >/var/log/nix-daemon.log 2>&1 &"
  for _ in $(seq 1 20); do pgrep -x nix-daemon >/dev/null 2>&1 && break; sleep 1; done
fi
pgrep -x nix-daemon >/dev/null 2>&1 || { log "daemon failed to start"; exit 1; }
log "ready: $("$PROFILE/bin/nix" --version 2>/dev/null)"
