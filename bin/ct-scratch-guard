#!/usr/bin/env perl
# ct-scratch-guard — Claude Code PreToolUse hook (Bash):
#   a command that does nothing but delete inside a workspace .scratch/ is
#   allowed without a prompt. It never asks and never denies.
#
#   ct-scratch-guard <workspace-root>      (install.sh registers it with CT_HOME)
#
# The conventions tell every agent to delete its own scratch files
# (docs/workspace-conventions.md). Outside auto mode an `rm` prompts unless
# something allows it, and no rule syntax can say "rm, but only under .scratch",
# so this hook says it:
#
#   the WHOLE command is `rm`s, each touching only <root>/<ws>/.scratch/<something>   -> "allow"
#   anything else, and anything it cannot prove                                        -> no output
#
# No output means Claude Code's normal flow decides: in auto mode the classifier
# (it refuses a delete of files the session did not make, a delete whose target
# it cannot see, a sweep of a shared directory), in the other modes a prompt.
#
# WHOLE, because a hook's "allow" is for the entire Bash call, not for the part
# the hook looked at. `rm <scratch file> && git push --force` is one call: an
# allow for its rm would be an allow for its push. Until 0.12 the guard judged
# only the rm segments and skipped every other, which was harmless while ask
# rules still prompted for the rest and stopped being so when they were retired
# (found in review, before release). So the command may hold `rm` commands
# joined by `;` or `&&`, their output sent to /dev/null, and nothing else: no
# other command, no pipe, no redirection to a file, no `$`, no backtick, no
# subshell, no background `&`.
#
# Until 0.12 it also answered "ask" where it now stays silent. A hook's "ask"
# forces a prompt and takes the decision away from the classifier, and "cannot
# prove" was most of what agents write: `cd dir && rm x`, an `rm` in a command
# that also holds `$(…)`, a heredoc whose text mentions rm. In the ten days
# after it was installed on one machine it raised 210 prompts, and the person
# refused one.
#
# Doubt is never "allow": variables, globs, sudo, an unparseable command,
# `.scratch` itself, a path leaving .scratch via `..` or a symlinked directory.
# Deny rules still win, and in plan mode Claude Code ignores a hook's allow for
# anything that writes. If the hook itself fails, the normal flow runs.
#
# perl with core modules only (JSON::PP, Text::ParseWords, Cwd), because jq and
# python3 are not on every base image ct installs onto.
use strict;
use warnings;
use JSON::PP;
use Text::ParseWords qw(shellwords);
use Cwd qw(abs_path);
use File::Basename qw(basename dirname);

my $root = shift @ARGV;
exit 0 unless defined $root && length $root;
$root =~ s{/+$}{};

my $raw = do { local $/; <STDIN> };
my $in = eval { decode_json($raw // '') };
exit 0 unless ref $in eq 'HASH';
my $cmd = $in->{tool_input}{command} // '';
my $cwd = $in->{cwd} // '';
exit 0 unless length $cmd;

sub allow {
    print encode_json({ hookSpecificOutput => {
        hookEventName => 'PreToolUse',
        permissionDecision => 'allow',
        permissionDecisionReason => 'nothing but rm inside a workspace .scratch/' } }), "\n";
    exit 0;
}
# Not provably scratch deletion and nothing else: say nothing, and the normal permission flow decides.
sub pass { exit 0 }

# Does the command involve rm at all? (a word; rmdir is not rm)
pass() unless $cmd =~ m{(?:^|[^\w./-])\\?(?:/usr)?(?:/bin/)?rm(?:\s|$)};

# Output sent nowhere is the one redirection it accepts: take those words out.
my $c = $cmd;
$c =~ s{(?:^|(?<=\s))(?:[12]?>\s*/dev/null|&>\s*/dev/null|2>&1)(?=\s|;|&&|$)}{ }g;

# What is left may hold words, quotes, `;` and `&&`. Anything that redirects,
# pipes, substitutes, groups, escapes or continues a line is not provable.
pass() if $c =~ /[<>|`\$(){}\\\n]/;

sub in_scratch {    # one path argument -> true if strictly inside <root>/<ws>/.scratch/
    my ($p) = @_;
    return 0 if $p =~ /[*?\[]/ || $p =~ /^~/;
    if ($p !~ m{^/}) {                                   # relative: against the session's directory
        return 0 unless length $cwd;
        $p = "$cwd/$p";
    }
    my $base = basename($p);
    return 0 if $base eq '' || $base eq '.' || $base eq '..' || $base eq '.scratch';
    my $dir = dirname($p);
    return 0 unless -d $dir;
    my $parent = abs_path($dir) // return 0;
    return 0 unless index($parent, "$root/") == 0;
    my ($ws) = substr($parent, length($root) + 1) =~ m{^([^/]+)};
    return 0 unless defined $ws;
    my $scratch = "$root/$ws/.scratch";
    return 0 if -l $scratch || !-d $scratch;
    return $parent eq $scratch || index($parent, "$scratch/") == 0;
}

my $found = 0;
for my $seg (split /&&|;/, $c) {
    $seg =~ s/^\s+|\s+$//g;
    next unless length $seg;                              # a trailing `;`
    pass() if $seg =~ /&/;                                # a background `&`, or half of something else
    my @t = shellwords($seg);
    pass() unless @t;                                     # a command line it cannot parse
    my $i;
    if ($t[0] =~ m{^(?:/usr)?(?:/bin/)?rm$}) { $i = 0 }
    elsif ($t[0] eq 'command' && ($t[1] // '') eq 'rm') { $i = 1 }
    elsif ($t[0] eq 'direnv' && ($t[1] // '') eq 'exec' && ($t[3] // '') eq 'rm') { $i = 3 }
    else { pass() }                                       # any other command: the allow would cover it too
    $found = 1;
    my ($paths, $only_paths) = (0, 0);
    for my $a (@t[$i + 1 .. $#t]) {
        if (!$only_paths && $a eq '--') { $only_paths = 1; next }
        if (!$only_paths && $a =~ /^-/) {
            next if $a =~ /^-[rRfiv]+$/ || $a =~ /^--(?:force|recursive|verbose|interactive=never)$/;
            pass();                                       # an option it does not know
        }
        pass() unless in_scratch($a);
        $paths++;
    }
    pass() unless $paths;
}
allow() if $found;
exit 0;
