#!/usr/bin/env perl
# ct-scratch-guard — Claude Code PreToolUse hook (Bash):
#   `rm` that provably stays inside a workspace .scratch/ is allowed, in every
#   permission mode. It never asks and never denies.
#
#   ct-scratch-guard <workspace-root>      (install.sh registers it with CT_HOME)
#
# The conventions tell every agent to delete its own scratch files
# (docs/workspace-conventions.md). Outside auto mode an `rm` prompts unless
# something allows it, and no rule syntax can say "rm, but only under .scratch",
# so this hook says it:
#
#   every rm touches only <root>/<ws>/.scratch/<something>   -> "allow"
#   anything else, and anything it cannot prove              -> no output
#
# No output means Claude Code's normal flow decides: in auto mode the classifier
# (it refuses a delete of files the session did not make, a delete whose target
# it cannot see, a sweep of a shared directory), in the other modes a prompt.
#
# Until 0.12 the second line was "ask". A hook's "ask" forces a prompt and takes
# the decision away from the classifier, and "cannot prove" was most of what
# agents write: `cd dir && rm x`, an `rm` in a command that also holds `$(…)`,
# a heredoc whose text mentions rm. In the ten days after it was installed on
# one machine it raised 210 prompts, and the person refused one.
#
# Doubt is still never "allow": variables, globs, $(...), backticks, sudo, an
# unparseable command, `.scratch` itself, a path leaving .scratch via `..` or a
# symlinked directory, a relative path after `cd`. Deny rules still win. If the
# hook itself fails, the normal flow runs.
#
# perl with core modules only (JSON::PP, Text::ParseWords, Cwd), because jq and
# python3 are not on every base image ct installs onto.
use strict;
use warnings;
use JSON::PP;
use Text::ParseWords qw(shellwords);
use Cwd qw(abs_path);
use File::Basename qw(basename dirname);

my $root = shift @ARGV;
exit 0 unless defined $root && length $root;
$root =~ s{/+$}{};

my $raw = do { local $/; <STDIN> };
my $in = eval { decode_json($raw // '') };
exit 0 unless ref $in eq 'HASH';
my $cmd = $in->{tool_input}{command} // '';
my $cwd = $in->{cwd} // '';
exit 0 unless length $cmd;

sub allow {
    print encode_json({ hookSpecificOutput => {
        hookEventName => 'PreToolUse',
        permissionDecision => 'allow',
        permissionDecisionReason => 'rm only inside a workspace .scratch/' } }), "\n";
    exit 0;
}
# Not provably scratch: say nothing, and the normal permission flow decides.
sub pass { exit 0 }

# Does the command involve rm at all? (a word; rmdir is not rm)
pass() unless $cmd =~ m{(?:^|[^\w./-])\\?(?:/usr)?(?:/bin/)?rm(?:\s|$)};

# rm next to a substitution cannot be inspected.
pass() if $cmd =~ /\$\(|`|<\(|>\(/;

my $has_cd = ($cmd =~ /(?:^|[;&|(\s])(?:cd|pushd|popd)(?:\s|$)/) ? 1 : 0;

sub in_scratch {    # one path argument -> true if strictly inside <root>/<ws>/.scratch/
    my ($p) = @_;
    return 0 if $p =~ /[*?\[{]/ || $p =~ /^~/;
    if ($p !~ m{^/}) {                                   # relative
        return 0 if $has_cd || !length $cwd;
        $p = "$cwd/$p";
    }
    my $base = basename($p);
    return 0 if $base eq '' || $base eq '.' || $base eq '..' || $base eq '.scratch';
    my $dir = dirname($p);
    return 0 unless -d $dir;
    my $parent = abs_path($dir) // return 0;
    return 0 unless index($parent, "$root/") == 0;
    my ($ws) = substr($parent, length($root) + 1) =~ m{^([^/]+)};
    return 0 unless defined $ws;
    my $scratch = "$root/$ws/.scratch";
    return 0 if -l $scratch || !-d $scratch;
    return $parent eq $scratch || index($parent, "$scratch/") == 0;
}

my $found = 0;
for my $seg (split /\|\||&&|;|\||&|\n/, $cmd) {
    $seg =~ s/^[\s({]+//;
    next unless length $seg;
    my @t = shellwords($seg);
    pass() unless @t;                                     # a command line it cannot parse
    my $i;
    my $w = $t[0];
    if ($w =~ m{^\\?(?:/usr)?(?:/bin/)?rm$}) { $i = 0 }
    elsif ($w =~ /^(?:command|env|nice|time|builtin)$/) { next unless ($t[1] // '') eq 'rm'; $i = 1 }
    elsif ($w =~ /^(?:sudo|doas)$/) { pass() if grep { $_ eq 'rm' } @t; next }   # rm as root
    elsif ($w eq 'direnv') { next unless ($t[1] // '') eq 'exec' && ($t[3] // '') eq 'rm'; $i = 3 }
    else { next }                                         # rm only as a word in another command
    $found = 1;
    pass() if $seg =~ /\$/;                               # a variable in its arguments
    my $paths = 0;
    for my $a (@t[$i + 1 .. $#t]) {
        next if $a eq '--';
        next if $a =~ /^(?:\d*[<>]|\d+$)/;                  # redirections: 2>/dev/null, the 1 of 2>&1
        if ($a =~ /^-/) {
            next if $a =~ /^-[rRfiv]+$/ || $a =~ /^--(?:force|recursive|verbose|interactive=never)$/;
            pass();                                       # an option it does not know
        }
        pass() unless in_scratch($a);
        $paths++;
    }
    pass() unless $paths;
}
allow() if $found;
exit 0;
