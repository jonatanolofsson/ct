#!/usr/bin/env bash
# ct-autostart — a detached session for every agent of every workspace: its saved
# conversation resumed, or a fresh one if it has none yet. Safe to run by hand at
# any time; it is what the pod runs ~45s after boot.
#
# Which agents a workspace runs is ct's record (~/.local/share/ct/agents/<ws>,
# written whenever ct launches one). No record means claude alone, so a workspace
# that never ran another agent comes back exactly as it always did. Launching is
# always `CT_AGENT=<agent> ct`: ct is the one place that knows how to start an
# agent, and this script never builds a command line of its own.
#
# Opt-in per user, by a file on the PVC:  touch ~/.ct-autostart
# Kill switch, wins over the above:       touch ~/.ct-noautostart
#
#   ct-autostart              one idempotent pass (boot, or by hand)
#   ct-autostart --loop       a pass every CT_AUTOSTART_INTERVAL seconds (300)
#   ct-autostart --restart    stop every managed session, then start them again
#   ct-autostart --supervise  run --loop forever, restarting it if it exits
#
# Every pass also reads the screen of each session that was already running and
# logs a WARNING when it is blank or waiting at a prompt: a session stuck at a
# trust, MCP or effort dialog looks perfectly healthy to every process check.
#
# Workspaces are the directories under ~/dev matching CT_AUTOSTART_GLOB
# (default agent-*; set it to * for plainly named workspaces).
#
# No `set -e`: one bad workspace must not stop the other eleven.
set -uo pipefail

log() { printf '%s ct-autostart: %s\n' "$(date -Is)" "$*"; }

# Modes. A plain pass is what boot runs. --loop exists because a boot-only model
# leaves two holes: a workspace created after boot gets no agent until the next
# pod restart, and an agent that dies stays dead until then. Re-running the
# (idempotent) pass on a timer closes both. --restart is for after upgrading
# claude, when every running agent is still the old binary.
mode=once
case "${1:-}" in
  "")          ;;
  --loop)      mode=loop ;;
  --restart)   mode=restart ;;
  --supervise) mode=supervise ;;
  *) log "unknown argument '$1' (expected --loop, --restart or --supervise)"; exit 2 ;;
esac

# --supervise: what a pod without systemd needs to keep the loop alive. Run it
# in the container that runs the agents — tmux's server lives in whichever
# container starts it, so supervising from a sidecar would put every agent
# inside the sidecar, and its restart would kill them all. It never exits on its
# own: while the kill switch is set or the opt-in is missing it waits (saying so
# once), so lifting either takes effect within one retry.
if [[ $mode == supervise ]]; then
  retry="${CT_AUTOSTART_RETRY:-30}" runs=0 waiting=""
  log "supervising ct-autostart --loop (restarted ${retry}s after it exits)"
  while :; do
    if [[ -e "$HOME/.ct-noautostart" ]]; then
      [[ $waiting == off ]] || log "waiting: ~/.ct-noautostart is set"; waiting=off
    elif [[ -z "${CT_AUTOSTART_FORCE:-}" && ! -e "$HOME/.ct-autostart" ]]; then
      [[ $waiting == optin ]] || log "waiting: not enabled (touch ~/.ct-autostart)"; waiting=optin
    else
      waiting=""
      "$0" --loop; rc=$?
      runs=$((runs+1))
      # Test hook: stop after N runs instead of supervising forever.
      if [[ -n "${CT_AUTOSTART_SUPERVISE_RUNS:-}" && $runs -ge $CT_AUTOSTART_SUPERVISE_RUNS ]]; then
        exit 0
      fi
      log "ct-autostart --loop exited ($rc) — starting it again in ${retry}s"
    fi
    sleep "$retry"
  done
fi

[[ -e "$HOME/.ct-noautostart" ]] && { log "disabled by ~/.ct-noautostart"; exit 0; }
if [[ -z "${CT_AUTOSTART_FORCE:-}" && ! -e "$HOME/.ct-autostart" ]]; then
  log "not enabled (touch ~/.ct-autostart to opt in); doing nothing"
  exit 0
fi

# tmux is NOT in the image — it is installed at runtime and lives on the
# container overlay, so every pod restart loses it. Prefer .debs cached on the
# PVC: at boot /var/lib/apt/lists is empty, so a bare `apt-get install` fails
# "Unable to locate package" and a full `apt-get update` must re-fetch three
# Debian indices over the network. Everything tmux needs except libjemalloc2 is
# already in the base image.
# `command -v tmux` is NOT a readiness check, and using one cost this script its
# first real boot (2026-08-23 20:21). dpkg unpacked tmux but could not CONFIGURE
# it: libevent-core-2.1-7t64 was missing from the cache, because the dependency
# closure had been derived on a pod where an earlier runtime `apt-get install
# tmux` had already pulled libevent in — so it looked like a base-image package
# when it was not. /usr/bin/tmux existed, `command -v` said yes, and all twelve
# launches failed. Actually RUN tmux, and repair a half-configured dpkg state
# instead of leaving it to poison the next apt call.
tmux_ok() { command -v tmux >/dev/null 2>&1 && tmux -V >/dev/null 2>&1; }

# Does the glob match anything? Not `compgen -G`: compgen exists only when bash
# was built with programmable completion (Fedora 43's bash has none, and there
# every check said "nothing"). The directory is quoted, only the pattern expands.
glob_any() { local f; for f in "$1"/$2; do [[ -e $f || -L $f ]] && return 0; done; return 1; }

if ! tmux_ok; then
  if glob_any "$HOME/.cache/debs" '*.deb'; then
    log "tmux not usable — installing from the PVC cache"
    sudo dpkg -i "$HOME"/.cache/debs/*.deb 2>&1 | tail -3 | sed 's/^/    dpkg: /'
    tmux_ok || {
      log "dpkg left it unconfigured — repairing dependencies"
      timeout 180 sudo apt-get -y --fix-broken install 2>&1 | tail -3 | sed 's/^/    fix-broken: /'
    }
  fi
fi
if ! tmux_ok; then
  log "tmux still not usable — falling back to apt (needs egress)"
  timeout 180 sudo apt-get update -qq 2>&1 | tail -2 | sed 's/^/    apt: /'
  timeout 180 sudo apt-get install -y -qq tmux 2>&1 | tail -3 | sed 's/^/    apt: /'
fi
tmux_ok || { log "no working tmux — cannot start any session, giving up"; exit 1; }
log "tmux ready: $(tmux -V)"

# Which directories under ~/dev are workspaces. The default keeps the agent-*
# naming; a site that names workspaces plainly (hus, mgb-ekonomi) sets
# CT_AUTOSTART_GLOB='*'. Dot-dirs are never workspaces — .gitcache/ lives here —
# and bash globs skip them anyway, but the explicit check survives `dotglob`.
workspaces() {
  local ws
  # The glob must stay unquoted so it expands.
  # shellcheck disable=SC2231
  for ws in "$HOME"/dev/${CT_AUTOSTART_GLOB:-agent-*}/; do
    ws=${ws%/}
    [[ -d $ws ]] || continue
    [[ ${ws##*/} == .* ]] && continue
    printf '%s\n' "$ws"
  done
}

# The workspace's name in session names and in ct's record. Must match ct's own
# sanitising exactly, or this script would look for sessions ct never names.
ws_key() { printf '%s' "${1##*/}" | tr -c 'A-Za-z0-9_-' '-'; }

state="${CT_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ct}"
records="$state/agents"
pins="$state/sessions"

# Where Claude keeps a directory's transcripts: every character that is not a
# letter or a digit becomes '-'. Same rule as ct's transcripts(); see there.
transcripts() { printf '%s/.claude/projects/%s' "$HOME" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '-')"; }

# A workspace's agents, one line each: "claude", or "opencode <port>". No record
# means claude — see the header. An empty record means none.
agents_of() { # workspace dir
  local f
  f="$records/$(ws_key "$1")"
  if [[ -f $f ]]; then awk 'NF' "$f"; else echo claude; fi
}

# How a session appears in the log. Claude keeps the bare workspace name, so
# every log line and alert written before agents existed still reads the same.
label() { # base agent
  if [[ $2 == claude ]]; then printf '%s' "$1"; else printf '%s [%s]' "$1" "$2"; fi
}

# Everything this script manages, one unit per line, fields separated by the
# ASCII unit separator (0x1f) — not tab: tab is whitespace to `read`, so an
# empty field (claude has no port) would collapse and shift every field after it:
#   agent  port  tmux-name  log-label  display-name  dir  session-id
# A workspace agent has an empty session id (ct picks the conversation); a
# pinned session (ct CT_SESSION_ID) carries its own, and its dir is the one the
# conversation is keyed on.
US=$'\x1f'
unit() { local IFS=$US; printf '%s\n' "$*"; }  # one unit, fields joined by US
units() {
  local ws key a port line f sid pname dir wss=() lines=()
  mapfile -t wss < <(workspaces)
  for ws in "${wss[@]}"; do
    key="$(ws_key "$ws")"
    mapfile -t lines < <(agents_of "$ws")
    for line in "${lines[@]}"; do
      read -r a port <<<"$line"
      unit "$a" "$port" "$a-$key" "$(label "${ws##*/}" "$a")" "${ws##*/}" "$ws" ""
    done
  done
  for f in "$pins"/*; do
    [[ -f $f ]] || continue
    read -r a sid pname dir < "$f"
    [[ $a == claude && -n $sid && -n $pname && -n $dir ]] || { log "${f##*/}: unreadable pinned-session record — skipping"; continue; }
    unit claude "" "claude-$(ws_key "$pname")" "$pname (pinned)" "$pname" "$dir" "$sid"
  done
}

# When this machine — or this container — started, in epoch seconds: PID 1's
# start time, from /proc (ticks since boot, plus the boot time). An agent whose
# last activity is older than this was alive at the restart; one that is newer
# died while the machine was up. CT_POD_START_EPOCH overrides it (tests).
machine_start() {
  [[ -n "${CT_POD_START_EPOCH:-}" ]] && { echo "$CT_POD_START_EPOCH"; return; }
  local ticks btime hz
  # Field 22 counted after the ")" that ends comm, which may itself hold spaces.
  ticks=$(sed 's/^.*) //' /proc/1/stat 2>/dev/null | awk '{print $20}')
  btime=$(awk '/^btime/ {print $2}' /proc/stat 2>/dev/null)
  hz=$(getconf CLK_TCK 2>/dev/null)
  [[ -n $ticks && -n $btime && -n $hz ]] || return 1
  echo $(( btime + ticks / hz ))
}

# --restart: stop the sessions this script manages and nothing else. Never the
# session running this command — killing that ends the very agent that asked
# for the restart, mid-command, before any new session has started.
stop_managed() {
  local self="" a port name lbl _ us=()
  if [[ -n "${TMUX:-}" ]]; then
    self="$(tmux display-message -p '#{session_name}' 2>/dev/null || true)"
  fi
  mapfile -t us < <(units)
  for u in "${us[@]}"; do
    IFS=$US read -r a port name lbl _ <<<"$u"
    tmux has-session -t "=$name" 2>/dev/null || continue
    if [[ $name == "$self" ]]; then
      log "$lbl: this command runs inside it — leaving it alone"; continue
    fi
    tmux kill-session -t "=$name" && log "$lbl: stopped"
  done
}

# Dialogs we can name, to make a warning say WHAT the session waits for. They
# are not what decides health: listing every dialog is an endless chase (the
# effort dialog has no footer this matches). See screen_problem.
DIALOG_RE="${CT_AUTOSTART_DIALOG_RE:-Enter to confirm|Do you trust|New MCP server found}"

# A running session that isn't usable: its screen can't be read, is blank, or
# shows something other than the input box. A process check says healthy in
# all of these. The test is POSITIVE: a healthy session, idle or working,
# always shows the input box, whose top border carries the session name
# (`──── <workspace> ─`, from `claude --name`). Every dialog replaces it. Warn
# only — answering a dialog is a person's call.
screen_problem() { # session display-name -> prints the problem, returns 1 if there is none
  local s
  # The trailing colon makes `=name` a session-qualified PANE; capture-pane
  # rejects a bare `=name`, and an error swallowed there reads as "all quiet".
  s=$(tmux capture-pane -p -t "=$1:" 2>/dev/null) || { echo "its screen could not be read"; return 0; }
  if [[ -z ${s//[[:space:]]/} ]]; then echo "blank screen"; return 0; fi
  grep -qF -- "─ $2 ─" <<<"$s" && return 1
  if grep -qE "$DIALOG_RE" <<<"$s"; then
    echo "waiting at a prompt: $(grep -m1 -E "$DIALOG_RE" <<<"$s" | sed 's/^[[:space:]]*//')"
  else
    echo "no input box on screen (a dialog?) — last line: $(grep -v '^[[:space:]]*$' <<<"$s" | tail -1 | sed 's/^[[:space:]]*//')"
  fi
  return 0
}

# A fresh session in a directory Claude doesn't trust yet stops at the trust
# dialog. Say so at start; the next pass's screen check will show it too.
untrusted() { # workspace dir -> true when ~/.claude.json does not trust it
  command -v jq >/dev/null 2>&1 || return 1
  [[ $(jq -r --arg p "$1" '.projects[$p].hasTrustDialogAccepted // false' "$HOME/.claude.json" 2>/dev/null) != true ]]
}

# opencode's health is not on its screen: it serves an HTTP API on the port ct
# recorded, and asking that is a sturdier check than reading a TUI. Like the
# screen check this only WARNS — a session that is up but not answering may be
# mid-way through something a person would not want killed.
http_problem() { # port -> prints the problem, returns 1 if there is none
  local body
  command -v curl >/dev/null 2>&1 || return 1   # nothing to probe with: say nothing
  [[ -n $1 ]] || { echo "no port recorded for it"; return 0; }
  body=$(curl -fsS -m "${CT_AUTOSTART_PROBE_TIMEOUT:-5}" "http://127.0.0.1:$1/global/health" 2>&1) ||
    { echo "its server on port $1 does not answer (${body//$'\n'/ })"; return 0; }
  [[ $body == *'"healthy":true'* ]] && return 1
  echo "its server on port $1 reports: $body"
  return 0
}

health_problem() { # agent session base port -> prints the problem, returns 1 if none
  case "$1" in
    claude)   screen_problem "$2" "$3" ;;
    opencode) http_problem "$4" ;;
    *)        return 1 ;;
  esac
}

# Start one unit through ct, from its directory. `wake` (set by run_round) adds
# CT_WAKE_SINCE when the wake message is on.
launch() { # agent session-id display-name
  if [[ -n $2 ]]; then
    env ${wake[@]+"${wake[@]}"} CT_SESSION_ID="$2" CT_NAME="$3" CT_DETACH=1 ct
  else
    env ${wake[@]+"${wake[@]}"} CT_AGENT="$1" CT_DETACH=1 ct
  fi
}

run_round() {
  local u a port name lbl display dir sid out note problem since="" started=0 skipped=0 failed=0 warned=0 us=()
  wake=()
  # The wake message (ct's wake_text): every agent this pass RESUMES is told
  # what happened. ct decides restart-vs-died from this and the conversation's
  # last activity, and stays silent for a fresh session. CT_WAKE=0: off.
  if [[ "${CT_WAKE:-1}" != 0 ]] && since=$(machine_start); then
    wake=(CT_WAKE_SINCE="$since")
  fi
  # Collected first, not read in a `while read` loop: ct and tmux inside the
  # loop body would inherit that loop's stdin and could swallow the list.
  mapfile -t us < <(units)
  for u in "${us[@]}"; do
    IFS=$US read -r a port name lbl display dir sid <<<"$u"

    # Idempotent: re-running must not double-start anything. Note this exits 1
    # with "no server running" when the tmux server is absent, which is exactly
    # the state at boot — so it must not be treated as an error.
    if tmux has-session -t "=$name" 2>/dev/null; then
      if problem=$(health_problem "$a" "$name" "$display" "$port"); then
        log "$lbl: WARNING — running, but $problem"; warned=$((warned+1))
      else
        log "$lbl: already running — skipping"
      fi
      skipped=$((skipped+1)); continue
    fi

    if [[ ! -d $dir ]]; then
      log "$lbl: WARNING — its directory $dir is gone; not started (CT_SESSION_ID=$sid CT_NAME=$display CT_AGENT_FORGET=1 ct forgets it)"
      warned=$((warned+1)); continue
    fi

    # Transcript check, for the log only, and only Claude's. A workspace IS an
    # agent — retiring one means removing its workspace — so one without a
    # transcript (created, never prompted) gets a fresh session. Skipping it,
    # as before, made a new agent vanish at its first pod restart. Bash globs
    # only: the transcript dirs start with a hyphen. opencode resumes from its
    # own store (ct passes --continue).
    note=""
    if [[ $a == claude && -z $sid ]] && ! glob_any "$(transcripts "$dir")" '*.jsonl'; then
      note=" (no transcript yet — fresh session)"
      untrusted "$dir" && note="$note — not trusted yet, will likely wait at the trust dialog"
    fi

    # No --continue here: ct resumes each agent's conversation on its own
    # (Claude by transcript id, see ct_pick_session). `--continue` only ever
    # meant "most recent in this directory", which for Claude silently prefers
    # a stub left behind by an accidental fresh start — exactly the failure
    # this loop must not automate across a whole fleet at boot.
    # Capture ct's output instead of discarding it. The first real boot logged
    # "FAILED to start" twelve times with no reason attached, because this line
    # sent stderr to /dev/null — the same silent-failure shape the rest of this
    # script is written to avoid.
    if out=$( cd "$dir" && launch "$a" "$sid" "$display" 2>&1 </dev/null ); then
      log "$lbl: started$note"; started=$((started+1))
    else
      log "$lbl: FAILED — ${out//$'\n'/ | }"; failed=$((failed+1))
    fi
    sleep "${CT_AUTOSTART_STAGGER:-10}"
  done

  log "done — started=$started skipped=$skipped failed=$failed warned=$warned"
  [[ $failed -eq 0 ]]
}

# One warm-up before the herd. Twelve agents starting at once would each try to
# refresh the same rotating OAuth token within seconds; the first wins and the
# rest can get invalid_grant, and a claude that exits takes its pane, its
# session, and — if it is the last one — the tmux server with it. Only when some
# workspace runs claude: opencode reads its keys from the environment and has no
# token to race on.
wants_claude() {
  units | cut -d "$US" -f1 | grep -qx claude
}
if [[ -z "${CT_AUTOSTART_NO_WARMUP:-}" ]] && wants_claude; then
  if timeout 90 claude -p 'ok' >/dev/null 2>&1; then
    log "credential warm-up ok"
  else
    log "credential warm-up failed (continuing anyway)"
  fi
fi

case "$mode" in
  once)    run_round ;;
  restart) stop_managed; run_round ;;
  loop)
    interval="${CT_AUTOSTART_INTERVAL:-300}"
    log "looping every ${interval}s (touch ~/.ct-noautostart to stop)"
    while :; do
      # Re-read every round, so the kill switch stops a running loop too.
      if [[ -e "$HOME/.ct-noautostart" ]]; then
        log "disabled by ~/.ct-noautostart — stopping the loop"; exit 0
      fi
      # A failed start is already logged; the loop must outlive it.
      run_round || true
      sleep "$interval"
    done ;;
esac
