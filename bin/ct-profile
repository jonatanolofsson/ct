#!/usr/bin/env bash
# ct-profile — set up the Claude Code half of a ct profile.
#
#   ct-profile claude <name>           a profile with its own claude.ai login
#   ct-profile claude <name> bedrock   one that runs Claude on the backend the
#                                      site defines in $CT_BEDROCK_SETTINGS
#   ct-profile move <workspace> <name> bring a workspace's conversations along
#        [--own-accounts]              ...and their Remote Control history, when
#                                      the profile's claude.ai account is also
#                                      the person's (see move below)
#        [--from <profile>]            ...from another profile, not ~/.claude
#
# A profile is <root>/.profiles/<name>/ (docs/workspace-conventions.md); a
# workspace naming it in its .envrc gets CLAUDE_CONFIG_DIR=<profile>/claude.
# Creating one starts from the machine's ~/.claude/settings.json, so the hooks
# (ct-scratch-guard), permissions and plansDirectory come along, and links the
# machine's skills, agents, commands and plugins, so they are kept in one place.
# It never copies a login: an account profile signs in once (`claude /login`
# from a workspace that uses it), a bedrock one needs none.
set -euo pipefail

root="${WORKSPACE_ROOT:-${CT_WORKSPACE_ROOT:-$HOME/dev}}"
from_cfg="$HOME/.claude"   # where move copies from: ~/.claude, or --from a profile
die() { echo "ct-profile: $*" >&2; exit 2; }
key() { printf '%s' "$1" | tr -c 'A-Za-z0-9' '-'; }

claude_profile() { # name [bedrock]
  local name="$1" kind="${2:-account}" dir src
  [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "'$name' is not a profile name ([a-z0-9-])"
  [[ $kind == account || $kind == bedrock ]] || die "unknown kind '$kind' (account or bedrock)"
  dir="$root/.profiles/$name/claude"
  if [[ -e $dir/settings.json ]]; then echo "ct-profile: $dir already exists; left as it is" >&2; return 0; fi
  if [[ $kind == bedrock && ! ( -n ${CT_BEDROCK_SETTINGS:-} && -f ${CT_BEDROCK_SETTINGS:-} ) ]]; then
    die "a bedrock profile needs CT_BEDROCK_SETTINGS: the site's settings for its backend (none here)"
  fi
  (umask 077 && mkdir -p "$dir")
  src="$HOME/.claude/settings.json"
  if [[ -f $src ]]; then cp "$src" "$dir/settings.json"; else echo '{}' > "$dir/settings.json"; fi
  # The copy has been through the installer's one-time migrations already; the
  # record goes with it. Without it the installer would run them again on the
  # profile and take out a rule its owner had put back into the machine's file.
  [[ -f $src && -f $HOME/.claude/.ct-migrations ]] && cp "$HOME/.claude/.ct-migrations" "$dir/.ct-migrations"
  for d in skills agents commands plugins; do
    [[ -e $HOME/.claude/$d ]] && ln -sfn "$HOME/.claude/$d" "$dir/$d"
  done
  if [[ $kind == bedrock ]]; then
    jq -s '.[0] * .[1] | .ct_profile_kind = "bedrock"' "$dir/settings.json" "$CT_BEDROCK_SETTINGS" > "$dir/settings.json.tmp"
    mv "$dir/settings.json.tmp" "$dir/settings.json"
  fi
  chmod 600 "$dir/settings.json"
  echo "ct-profile: $dir ready ($kind)" >&2
}

# A conversation records which claude.ai account it ran under, in four kinds
# of row: `bridge-session` (the Remote Control session it was linked to, and
# that session's owner), `session-owner` (the account and organization it
# belongs to), the `credential_org` attachments (the organization each turn
# was sent with) and the `compact_boundary` rows (the organizations each
# compaction summarised, in preCompactOrganizations: a long conversation has
# them, a short test one does not, which is how the fourth went unnoticed).
# Resumed under another account, Claude Code takes any of them as "this
# conversation names another sign-in": it writes a `history-suppression` row,
# or opens the remote session with noHistoryBackfill, and Remote Control shows
# it without its history or its name, on every later start too. That guard is
# right when the accounts belong to different people. --own-accounts says they
# are both the person's: each conversation is copied under a new id, without
# the first two kinds of row and with every credential_org and
# preCompactOrganizations naming the profile's own organization, so its first
# start in the profile opens a remote session with the whole history and name.
# That is why the profile must be signed in first: its organization is read
# from its .claude.json.
move() { # workspace name [--own-accounts] [--from <profile>]
  local ws="" name="" own="" src_profile="" from to f id new org="" n=0 linked=0 s lines
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --own-accounts) own=1 ;;
      --from) [[ $# -ge 2 ]] || die "--from needs a profile name"; src_profile="$2"; shift ;;
      --*) die "unknown option '$1'" ;;
      *) if [[ -z $ws ]]; then ws="$1"; elif [[ -z $name ]]; then name="$1"; else die "too many arguments"; fi ;;
    esac
    shift
  done
  [[ -n $ws && -n $name ]] || die "usage: ct-profile move <workspace> <name> [--own-accounts] [--from <profile>]"
  # A bare name means a workspace under the root; either way the key must be
  # built from the absolute path, as Claude Code builds its project directory.
  [[ -d $ws || ! -d $root/$ws ]] || ws="$root/$ws"
  [[ -d $ws ]] || die "no workspace $ws"
  ws="$(cd "$ws" && pwd)"
  # The conversations come from the machine's ~/.claude, or with --from from
  # another profile's: a workspace that already lives in one profile and moves
  # to the next.
  from_cfg="$HOME/.claude"
  if [[ -n $src_profile ]]; then
    from_cfg="$root/.profiles/$src_profile/claude"
    [[ -d $from_cfg ]] || die "no profile $src_profile to move from"
    [[ $src_profile != "$name" ]] || die "--from and the target are the same profile"
  fi
  from="$from_cfg/projects/$(key "$ws")"
  to="$root/.profiles/$name/claude/projects/$(key "$ws")"
  [[ -d "$root/.profiles/$name/claude" ]] || die "no profile $name (ct-profile claude $name first)"
  if [[ -n $own ]]; then
    org="$(jq -r '.oauthAccount.organizationUuid // empty' "$root/.profiles/$name/claude/.claude.json" 2>/dev/null || true)"
    [[ $org =~ ^[0-9a-f-]{36}$ ]] ||
      die "--own-accounts needs $name signed in first (CLAUDE_CONFIG_DIR=$root/.profiles/$name/claude claude auth login): it names the profile's organization in the copy"
  fi
  [[ -d $from ]] || { echo "ct-profile: nothing to move ($from does not exist)" >&2; return 0; }
  # A running agent keeps writing the original, so the copy would miss its last
  # turns; ct-autostart would start it again within minutes, hence the pause.
  if tmux has-session -t "=claude-$(ws_key "$ws")" 2>/dev/null; then
    die "the agent of ${ws##*/} is running: touch ~/.ct-noautostart, tmux kill-session -t =claude-$(ws_key "$ws"), then move"
  fi
  if [[ -n $own ]] && has_transcripts "$to"; then
    die "$to already has conversations: --own-accounts copies under new ids, so a second run would duplicate them"
  fi
  mkdir -p "$to"
  # Copy, not move: the conversation stays where it was, too, until the person
  # is sure (docs/workspace-conventions.md). A resume in the profile carries on
  # with the whole history, on whatever backend the profile uses.
  if [[ -z $own ]]; then
    cp -a "$from/." "$to/"
    for f in "$to"/*.jsonl; do
      [[ -e $f ]] || continue
      id="$(basename "$f" .jsonl)"; n=$((n + 1))
      if grep -q '"type":"bridge-session"' "$f"; then linked=$((linked + 1)); fi
      copy_history "$id" "$id" "$name"
      copy_uploads "$id" "$id" "$name"
      sed -i "$(upload_paths "$id" "$id" "$name")" "$f"
    done
    echo "ct-profile: copied $n conversation(s) into $name" >&2
    if (( linked > 0 )); then
      echo "ct-profile: $linked of them were linked to Remote Control; if $name signs in to another claude.ai account, they show there without history or name (see --own-accounts)" >&2
    fi
    return 0
  fi
  for f in "$from"/*; do
    [[ -e $f && $f != *.jsonl ]] || continue
    id="$(basename "$f")"
    # memory and the like; a conversation's own directory follows it below
    [[ -e $from/$id.jsonl ]] || cp -a "$f" "$to/"
  done
  for f in "$from"/*.jsonl; do
    [[ -e $f ]] || continue
    id="$(basename "$f" .jsonl)"; new="$(new_id)"; n=$((n + 1))
    own_copy "$f" "$to/$new.jsonl" "$id" "$new"
    # The conversation's own directory holds its subagents' transcripts, and
    # Claude Code reads them too: they name the parent's id and carry their
    # own credential_org rows, so they get the same rewrite.
    if [[ -d $from/$id ]]; then
      cp -a "$from/$id" "$to/$new"
      while IFS= read -r -d '' s; do
        own_copy "$s" "$s.ct-tmp" "$id" "$new" && mv "$s.ct-tmp" "$s"
      done < <(find "$to/$new" -name '*.jsonl' -print0)
    fi
    copy_history "$id" "$new" "$name"
    copy_uploads "$id" "$new" "$name"
    lines="$(wc -l < "$to/$new.jsonl")"
    if (( lines >= rc_scan_lines )); then
      echo "ct-profile: $new still has $lines lines; Remote Control will show it without its history (it scans at most $rc_scan_lines)" >&2
    fi
  done
  echo "ct-profile: copied $n conversation(s) into $name under new ids, unlinked from Remote Control" >&2
}

# Before Claude Code back-fills a new Remote Control session it scans the
# transcript for another account's rows, and it stops after 100 000 lines. A
# longer transcript has its history withheld as a precaution, with no message
# saying so. A moved conversation always gets a new remote session, so a long
# one would always come up empty. Most of the length is rows Claude Code
# appends again on every turn, of which only the last counts: the title, the
# agent name, the mode, the last prompt. Keeping only the last of each took a
# conversation of 113 000 lines to 79 000 without touching a message.
rc_scan_lines=100000
last_wins='custom-title|agent-name|permission-mode|mode|atis-latch|last-prompt'

own_copy() { # src dst old-id new-id: one transcript, rewritten for the profile's account
  # Rows are matched from the start of the line: a turn that only quotes one
  # of these names (an agent reading a transcript) is part of the
  # conversation's chain, and dropping it would break the chain.
  grep -Ev '^\{"type":"(bridge-session|history-suppression|session-owner)"' "$1" \
    | sed -e "$(upload_paths "$3" "$4" "$name")" -e "s/$3/$4/g" \
          -e "s/\"attachment\":{\"type\":\"credential_org\",\"organizationUuid\":\"[0-9a-f-]*\"/\"attachment\":{\"type\":\"credential_org\",\"organizationUuid\":\"$org\"/g" \
          -e "s/\"preCompactOrganizations\":\[[^]]*\]/\"preCompactOrganizations\":[\"$org\"]/g" \
    | tac | awk -v lw="$last_wins" '
        match($0, "^[{]\"type\":\"(" lw ")\"") { t = substr($0, 10, RLENGTH - 10); if (seen[t]++) next }
        { print }' | tac > "$2" || true
  chmod --reference="$1" "$2"
  touch -r "$1" "$2"   # ct resumes the newest transcript: keep their order
}

copy_history() { # old-id new-id profile: the checkpoints /rewind restores from
  local src="$from_cfg/file-history/$1" dst="$root/.profiles/$3/claude/file-history/$2"
  [[ -d $src && ! -e $dst ]] || return 0
  mkdir -p "${dst%/*}"; cp -a "$src" "$dst"
}

# The files the person attached (PDFs, screenshots) live beside the transcript,
# in uploads/<conversation id>/, and the transcript names them by absolute path.
# Without them a moved conversation remembers what it read but cannot open it
# again, and under a new id its paths name a folder that does not exist.
copy_uploads() { # old-id new-id profile
  local src="$from_cfg/uploads/$1" dst="$root/.profiles/$3/claude/uploads/$2"
  [[ -d $src && ! -e $dst ]] || return 0
  mkdir -p "${dst%/*}"; cp -a "$src" "$dst"
}

# A sed script that points the transcript's upload paths at the profile's copy:
# both the spelling through ~/.claude and the real path, which differs when
# ~/.claude is a link (into another profile, say). A path written relative to a
# working directory is left as it is: there is no telling what it was relative to.
upload_paths() { # old-id new-id profile
  local dst="$root/.profiles/$3/claude/uploads/$2" via="$from_cfg" real p script=""
  real="$(cd "$via" && pwd -P)"
  for p in "$via" "$real"; do script+="s|$(re_quote "$p/uploads/$1")|$dst|g;"; done
  printf '%s' "$script"
}
re_quote() { printf '%s' "$1" | sed 's/[][\.^$*|]/\\&/g'; }

has_transcripts() { local f; for f in "$1"/*.jsonl; do [[ -e $f ]] && return 0; done; return 1; }
ws_key() { printf '%s' "${1##*/}" | tr -c 'A-Za-z0-9_-' '-'; }   # as ct-autostart names sessions

new_id() {
  if [[ -r /proc/sys/kernel/random/uuid ]]; then cat /proc/sys/kernel/random/uuid
  else uuidgen | tr '[:upper:]' '[:lower:]'; fi
}

case "${1:-}" in
  claude) shift; [[ $# -ge 1 ]] || die "usage: ct-profile claude <name> [bedrock]"; claude_profile "$@" ;;
  move)   shift; move "$@" ;;
  *) die "usage: ct-profile claude <name> [bedrock] | move <workspace> <name> [--own-accounts] [--from <profile>]" ;;
esac
