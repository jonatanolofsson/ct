#!/usr/bin/env bash
# ct-profile — the Claude Code half of a ct profile.
#
#   ct-profile new <name>              a profile for a claude.ai subscription:
#                                      sign it in once (`claude auth login`)
#   ct-profile new <name> gateway      one that runs Claude through the site's
#                                      gateway, from $CT_GATEWAY_SETTINGS: no
#                                      login, and no Remote Control (Claude Code
#                                      offers it only through api.anthropic.com)
#   ct-profile transfer <workspace> <name>
#                                      move a workspace's agent onto that
#                                      profile: stop it, bring its conversations
#                                      along, point the workspace at the profile
#                                      (its other logins pinned where they
#                                      were), start it again
#
# A profile is <root>/.profiles/<name>/ (docs/workspace-conventions.md); a
# workspace naming it in its .envrc gets CLAUDE_CONFIG_DIR=<profile>/claude.
# Creating one starts from the machine's ~/.claude/settings.json, so the hooks
# (ct-scratch-guard), permissions and plansDirectory come along, and links the
# machine's skills, agents, commands and plugins, so they are kept in one place.
# It never copies a login.
set -euo pipefail

root="${WORKSPACE_ROOT:-${CT_WORKSPACE_ROOT:-$HOME/dev}}"
from_cfg="$HOME/.claude"   # where a transfer copies from: ~/.claude, or the profile it was on
die() { echo "ct-profile: $*" >&2; exit 2; }
key() { printf '%s' "$1" | tr -c 'A-Za-z0-9' '-'; }

new_profile() { # name [subscription|gateway]
  local name="$1" kind="${2:-subscription}" dir src
  [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "'$name' is not a profile name ([a-z0-9-])"
  [[ $kind == subscription || $kind == gateway ]] || die "unknown kind '$kind' (subscription or gateway)"
  dir="$root/.profiles/$name/claude"
  if [[ -e $dir/settings.json ]]; then echo "ct-profile: $dir already exists; left as it is" >&2; return 0; fi
  if [[ $kind == gateway && ! ( -n ${CT_GATEWAY_SETTINGS:-} && -f ${CT_GATEWAY_SETTINGS:-} ) ]]; then
    die "a gateway profile needs CT_GATEWAY_SETTINGS: the site's settings for its gateway (none here)"
  fi
  (umask 077 && mkdir -p "$dir")
  src="$HOME/.claude/settings.json"
  if [[ -f $src ]]; then cp "$src" "$dir/settings.json"; else echo '{}' > "$dir/settings.json"; fi
  # The copy has been through the installer's one-time migrations already; the
  # record goes with it. Without it the installer would run them again on the
  # profile and take out a rule its owner had put back into the machine's file.
  [[ -f $src && -f $HOME/.claude/.ct-migrations ]] && cp "$HOME/.claude/.ct-migrations" "$dir/.ct-migrations"
  for d in skills agents commands plugins; do
    [[ -e $HOME/.claude/$d ]] && ln -sfn "$HOME/.claude/$d" "$dir/$d"
  done
  if [[ $kind == gateway ]]; then
    jq -s '.[0] * .[1] | .ct_profile_kind = "gateway"' "$dir/settings.json" "$CT_GATEWAY_SETTINGS" > "$dir/settings.json.tmp"
    mv "$dir/settings.json.tmp" "$dir/settings.json"
  fi
  chmod 600 "$dir/settings.json"
  echo "ct-profile: $dir ready ($kind)" >&2
}

# A conversation records which claude.ai account it ran under, in four kinds
# of row: `bridge-session` (the Remote Control session it was linked to, and
# that session's owner), `session-owner` (the account and organization it
# belongs to), the `credential_org` attachments (the organization each turn
# was sent with) and the `compact_boundary` rows (the organizations each
# compaction summarised, in preCompactOrganizations: a long conversation has
# them, a short test one does not, which is how the fourth went unnoticed).
# Resumed under another account, Claude Code takes any of them as "this
# conversation names another sign-in": it writes a `history-suppression` row,
# or opens the remote session with noHistoryBackfill, and Remote Control shows
# it without its history or its name, on every later start too. That guard is
# right when the accounts belong to different people. A transfer to a profile
# with a login of its own takes them to be both the person's (relink): each
# conversation is copied under a new id, without
# the first two kinds of row and with every credential_org and
# preCompactOrganizations naming the profile's own organization, so its first
# start in the profile opens a remote session with the whole history and name.
# That is why it needs the profile's login: its organization is read from its
# .claude.json. A profile without one (a gateway) gets a plain copy: its agents
# have no Remote Control to show history in.
#
# Called by transfer, with the agent stopped (a running one keeps writing the
# original, and the copy would miss its last turns) and from_cfg set to where
# the workspace's Claude was.
copy_conversations() { # workspace-dir profile org (empty: a plain copy)
  local ws="$1" name="$2" org="$3" from to f id new n=0 s lines
  from="$from_cfg/projects/$(key "$ws")"
  to="$root/.profiles/$name/claude/projects/$(key "$ws")"
  [[ -d $from ]] || { echo "ct-profile: no conversations to bring along ($from does not exist)" >&2; return 0; }
  mkdir -p "$to"
  # Copy, not move: the conversation stays where it was, too, until the person
  # is sure (docs/workspace-conventions.md). A resume in the profile carries on
  # with the whole history, on whatever backend the profile uses.
  if [[ -z $org ]]; then
    cp -a "$from/." "$to/"
    for f in "$to"/*.jsonl; do
      [[ -e $f ]] || continue
      id="$(basename "$f" .jsonl)"; n=$((n + 1))
      copy_history "$id" "$id" "$name"
      copy_uploads "$id" "$id" "$name"
      sed -i "$(upload_paths "$id" "$id" "$name")" "$f"
    done
    echo "ct-profile: copied $n conversation(s) into $name" >&2
    return 0
  fi
  for f in "$from"/*; do
    [[ -e $f && $f != *.jsonl ]] || continue
    id="$(basename "$f")"
    # memory and the like; a conversation's own directory follows it below
    [[ -e $from/$id.jsonl ]] || cp -a "$f" "$to/"
  done
  for f in "$from"/*.jsonl; do
    [[ -e $f ]] || continue
    id="$(basename "$f" .jsonl)"; new="$(new_id)"; n=$((n + 1))
    own_copy "$f" "$to/$new.jsonl" "$id" "$new"
    # The conversation's own directory holds its subagents' transcripts, and
    # Claude Code reads them too: they name the parent's id and carry their
    # own credential_org rows, so they get the same rewrite.
    if [[ -d $from/$id ]]; then
      cp -a "$from/$id" "$to/$new"
      while IFS= read -r -d '' s; do
        own_copy "$s" "$s.ct-tmp" "$id" "$new" && mv "$s.ct-tmp" "$s"
      done < <(find "$to/$new" -name '*.jsonl' -print0)
    fi
    copy_history "$id" "$new" "$name"
    copy_uploads "$id" "$new" "$name"
    lines="$(wc -l < "$to/$new.jsonl")"
    if (( lines >= rc_scan_lines )); then
      echo "ct-profile: $new still has $lines lines; Remote Control will show it without its history (it scans at most $rc_scan_lines)" >&2
    fi
  done
  echo "ct-profile: copied $n conversation(s) into $name under new ids, unlinked from Remote Control" >&2
}

# Before Claude Code back-fills a new Remote Control session it scans the
# transcript for another account's rows, and it stops after 100 000 lines. A
# longer transcript has its history withheld as a precaution, with no message
# saying so. A moved conversation always gets a new remote session, so a long
# one would always come up empty. Most of the length is rows Claude Code
# appends again on every turn, of which only the last counts: the title, the
# agent name, the mode, the last prompt. Keeping only the last of each took a
# conversation of 113 000 lines to 79 000 without touching a message.
rc_scan_lines=100000
last_wins='custom-title|agent-name|permission-mode|mode|atis-latch|last-prompt'

own_copy() { # src dst old-id new-id: one transcript, rewritten for the profile's account (org, name: the caller's)
  # Rows are matched from the start of the line: a turn that only quotes one
  # of these names (an agent reading a transcript) is part of the
  # conversation's chain, and dropping it would break the chain.
  grep -Ev '^\{"type":"(bridge-session|history-suppression|session-owner)"' "$1" \
    | sed -e "$(upload_paths "$3" "$4" "$name")" -e "s/$3/$4/g" \
          -e "s/\"attachment\":{\"type\":\"credential_org\",\"organizationUuid\":\"[0-9a-f-]*\"/\"attachment\":{\"type\":\"credential_org\",\"organizationUuid\":\"$org\"/g" \
          -e "s/\"preCompactOrganizations\":\[[^]]*\]/\"preCompactOrganizations\":[\"$org\"]/g" \
    | tac | awk -v lw="$last_wins" '
        match($0, "^[{]\"type\":\"(" lw ")\"") { t = substr($0, 10, RLENGTH - 10); if (seen[t]++) next }
        { print }' | tac > "$2" || true
  chmod --reference="$1" "$2"
  touch -r "$1" "$2"   # ct resumes the newest transcript: keep their order
}

# transfer: move a workspace's agent onto a profile's Claude, and only that. The
# workspace may be on the machine's ~/.claude (no ct_profile= value in its
# .envrc) or on another profile. Its conversations come along: to a profile with
# a claude.ai login of its own they are relinked (copy_conversations), so Remote
# Control shows their history under that account; to one without (a gateway)
# they are copied as they are. Every OTHER login its .envrc sets (gcloud and the
# rest, which also follow ct_profile=) is pinned where it was, in a marked
# block, so the accounts the agent reaches never change with its Claude. This is
# also what a profile manager runs when a subscription is out of usage
# (ct-manager, docs/profile-managers.md). It is for one person's own accounts:
# relinking hands a conversation's whole history to the target account.
#
# Exit 0 transferred (or already there), 3 the agent is mid-turn (try again when
# it is idle), 2 refused. One transfer at a time per root: a lock in .profiles/.
transfer() { # workspace profile
  local ws="${1:-}" to="${2:-}" d from before line name block="" note tp k cfg src sw org="" from_label bak want who_from who_to
  [[ $# -eq 2 ]] || die "usage: ct-profile transfer <workspace> <profile>"
  [[ -d $ws || ! -d $root/$ws ]] || ws="$root/$ws"
  [[ -f $ws/.envrc ]] || die "no workspace $ws with an .envrc"
  d="$(cd "$ws" && pwd)"
  grep -q '^ct_profile=' "$d/.envrc" || die "${d##*/}'s .envrc has no ct_profile= line (ct writes one; run ct there once)"
  mkdir -p "$root/.profiles"
  exec 9>"$root/.profiles/.transfer.lock"
  flock -w "${CT_TRANSFER_WAIT:-900}" 9 || die "another transfer holds $root/.profiles/.transfer.lock"
  from="$(sed -n 's/^ct_profile=//p' "$d/.envrc" | head -1)"
  [[ $from != "$to" ]] || { echo "ct-profile: ${d##*/} is on $to already" >&2; return 0; }
  [[ -d $root/.profiles/$to/claude ]] || die "no profile $to (ct-profile new $to first)"
  if [[ -n $from ]]; then
    from_cfg="$root/.profiles/$from/claude"; from_label="$from"; src="$from_cfg/.claude.json"
  else
    from_cfg="$HOME/.claude"; from_label="the machine's ~/.claude"; src="$HOME/.claude.json"
  fi
  if jq -e '.oauthAccount.organizationUuid // empty' "$root/.profiles/$to/claude/.claude.json" >/dev/null 2>&1; then
    org="$(jq -r '.oauthAccount.organizationUuid' "$root/.profiles/$to/claude/.claude.json")"
    [[ $org =~ ^[0-9a-f-]{36}$ ]] || die "$to's login names no organization"
    # Relinking hands the conversations' history to the target's account. Say so
    # when the two logins are different addresses: one person's accounts often
    # are, but two people's always are.
    who_from="$(jq -r '.oauthAccount.emailAddress // empty' "$src" 2>/dev/null || true)"
    who_to="$(jq -r '.oauthAccount.emailAddress // empty' "$root/.profiles/$to/claude/.claude.json" 2>/dev/null || true)"
    if [[ -n $who_from && -n $who_to && $who_from != "$who_to" ]]; then
      echo "ct-profile: note: ${d##*/}'s history moves from $who_from's account to $who_to's; transfer only between one person's own accounts" >&2
    fi
  elif ! jq -e '.ct_profile_kind == "gateway" or .ct_profile_kind == "bedrock"' "$root/.profiles/$to/claude/settings.json" >/dev/null 2>&1; then
    die "$to is not signed in (CLAUDE_CONFIG_DIR=$root/.profiles/$to/claude claude auth login)"
  fi
  sw="claude-$(ws_key "$d")"
  if tmux has-session -t "=$sw" 2>/dev/null && tmux capture-pane -p -t "$sw:" 2>/dev/null | grep -q 'esc to interrupt'; then
    echo "ct-profile: ${d##*/} is mid-turn; transfer it when it is idle" >&2; exit 3
  fi

  # The login variables: the usual ones, and every one the .envrc exports.
  local -a vars
  mapfile -t vars < <({ echo CLOUDSDK_CONFIG; echo GOOGLE_APPLICATION_CREDENTIALS
    sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$d/.envrc"; } | grep -vx CLAUDE_CONFIG_DIR | sort -u)
  # `|| true`: an environment that sets none of them is an answer too, not an
  # error that ends the transfer under `set -e`.
  envof() { { (cd "$d" && direnv exec . env 2>/dev/null) | grep -E "^($(IFS='|'; echo "${vars[*]}"))=" || true; } | sort; }
  # shellcheck disable=SC2016  # expanded by the inner shell, in the .envrc's environment
  claude_of() { (cd "$d" && direnv exec . sh -c 'printf %s "${CLAUDE_CONFIG_DIR:-}"' 2>/dev/null) || true; }
  before="$(envof)"

  # Trust and onboarding in the target, so the agent starts without a dialog.
  cfg="$root/.profiles/$to/claude/.claude.json"
  [[ -f $src ]] || src=/dev/null
  [[ -f $cfg ]] || echo '{}' > "$cfg"
  jq --slurpfile s <(cat "$src" 2>/dev/null || echo '{}') --arg k "$d" '
    .hasCompletedOnboarding = true
    | .projects[$k] = ((.projects[$k] // {}) + (($s[0] // {}).projects[$k] // {})
                       + {hasTrustDialogAccepted: true, hasCompletedProjectOnboarding: true})' \
    "$cfg" > "$cfg.ct-tmp"
  chmod 600 "$cfg.ct-tmp"; mv "$cfg.ct-tmp" "$cfg"

  # Stop the agent, with ct-autostart held off for the moment of the move.
  # A global, not a local: the EXIT trap reads it after this function returns.
  # shellcheck disable=SC2034
  transfer_paused=0
  # shellcheck disable=SC2034
  if [[ ! -e $HOME/.ct-noautostart ]]; then touch "$HOME/.ct-noautostart"; transfer_paused=1; fi
  trap 'if ((transfer_paused)); then rm -f "$HOME/.ct-noautostart"; fi' EXIT
  tmux kill-session -t "=$sw" 2>/dev/null || true
  sleep "${CT_TRANSFER_SETTLE:-2}"

  # A copy left from an earlier stay in the target would sit beside the new one
  # (a relinked copy gets new ids), and ct would resume whichever is newest: set
  # it aside, dated.
  k="$(key "$d")"; tp="$root/.profiles/$to/claude/projects/$k"
  if has_transcripts "$tp"; then mv "$tp" "$tp.superseded-$(date -u +%Y%m%dT%H%M%S)"; fi
  copy_conversations "$d" "$to" "$org"

  mkdir -p "$root/.profiles/.transfer-backups"
  bak="$root/.profiles/.transfer-backups/${d##*/}.envrc.$(date -u +%Y%m%dT%H%M%S)"
  cp "$d/.envrc" "$bak"
  sed -i "s/^ct_profile=.*/ct_profile=$to/" "$d/.envrc"
  perl -0pi -e 's/^# >>> ct-profile transfer\b.*?^# <<< ct-profile transfer[^\n]*\n\n?//msg' "$d/.envrc"
  direnv allow "$d" >/dev/null 2>&1 || true
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    name="${line%%=*}"
    grep -qxF "$line" <<<"$(envof)" || block+="export $name=\"${line#*=}\""$'\n'
  done <<<"$before"
  # An older .envrc has no line that points Claude at the profile (the
  # conventions say to add one); without it the agent would start on its old
  # Claude, and resume nothing, under a message that says it moved.
  want="$root/.profiles/$to/claude"
  [[ "$(claude_of)" == "$want" ]] || block+="export CLAUDE_CONFIG_DIR=\"$want\""$'\n'
  note="# >>> ct-profile transfer: Claude on $to since $(date -u +%F), from $from_label; other logins stay where they were
${block}# <<< ct-profile transfer"
  if grep -q '^source_env_if_exists \.envrc\.local' "$d/.envrc"; then
    NOTE="$note" perl -0pi -e 's/^(source_env_if_exists \.envrc\.local)/$ENV{NOTE}\n\n$1/m' "$d/.envrc"
  else
    printf '\n%s\n' "$note" >> "$d/.envrc"
  fi
  direnv allow "$d" >/dev/null 2>&1 || true
  if [[ "$(envof)" != "$before" || "$(claude_of)" != "$want" ]]; then
    cp "$bak" "$d/.envrc"; direnv allow "$d" >/dev/null 2>&1 || true
    die "${d##*/}: its .envrc would not point Claude at $to and keep its other logins; it is put back as it was ($bak), and the conversations are copied to $to already"
  fi

  (cd "$d" && CT_DETACH=1 "$(dirname "$(readlink -f "$0")")/ct" >/dev/null 2>&1) ||
    die "${d##*/} transferred to $to, but ct could not start it"
  echo "ct-profile: ${d##*/} transferred from $from_label to $to and started" >&2
}

# Both merge into what the target already holds: a plain copy keeps the
# conversation's id, so a workspace that was on this profile before finds its
# old folder there, and what was added since must not be skipped.
copy_history() { # old-id new-id profile: the checkpoints /rewind restores from
  local src="$from_cfg/file-history/$1" dst="$root/.profiles/$3/claude/file-history/$2"
  [[ -d $src ]] || return 0
  mkdir -p "$dst"; cp -a "$src/." "$dst/"
}

# The files the person attached (PDFs, screenshots) live beside the transcript,
# in uploads/<conversation id>/, and the transcript names them by absolute path.
# Without them a moved conversation remembers what it read but cannot open it
# again, and under a new id its paths name a folder that does not exist.
copy_uploads() { # old-id new-id profile
  local src="$from_cfg/uploads/$1" dst="$root/.profiles/$3/claude/uploads/$2"
  [[ -d $src ]] || return 0
  mkdir -p "$dst"; cp -a "$src/." "$dst/"
}

# A sed script that points the transcript's upload paths at the profile's copy:
# both the spelling through ~/.claude and the real path, which differs when
# ~/.claude is a link (into another profile, say). A path written relative to a
# working directory is left as it is: there is no telling what it was relative to.
upload_paths() { # old-id new-id profile
  local dst="$root/.profiles/$3/claude/uploads/$2" via="$from_cfg" real p script=""
  real="$(cd "$via" && pwd -P)"
  for p in "$via" "$real"; do script+="s|$(re_quote "$p/uploads/$1")|$dst|g;"; done
  printf '%s' "$script"
}
re_quote() { printf '%s' "$1" | sed 's/[][\.^$*|]/\\&/g'; }

has_transcripts() { local f; for f in "$1"/*.jsonl; do [[ -e $f ]] && return 0; done; return 1; }
ws_key() { printf '%s' "${1##*/}" | tr -c 'A-Za-z0-9_-' '-'; }   # as ct-autostart names sessions

new_id() {
  if [[ -r /proc/sys/kernel/random/uuid ]]; then cat /proc/sys/kernel/random/uuid
  else uuidgen | tr '[:upper:]' '[:lower:]'; fi
}

case "${1:-}" in
  new)      shift; [[ $# -ge 1 && $# -le 2 ]] || die "usage: ct-profile new <name> [subscription|gateway]"; new_profile "$@" ;;
  transfer) shift; transfer "$@" ;;
  -h|--help|help) sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) die "usage: ct-profile new <name> [subscription|gateway] | transfer <workspace> <profile>" ;;
esac
