#!/usr/bin/env bash
# ct — launch or reattach a tmux'd Claude Code session for the current WORKSPACE.
#
# BOTH names come from the workspace: the tmux session name, and the Claude
# session display name passed as `claude --name`. Neither depends on the directory
# you happen to be standing in, so `ct` reaches the same agent from the workspace
# root or from any repo clone inside it. That is also what keeps workspaces apart:
# when several workspaces hold a clone of the SAME repo, naming from the current
# directory collided them all onto one session (and one agent).
#
# tmux daemonizes, so the session survives closing this terminal, a code-server
# window reload, and extension-host recycles. Only a POD restart stops it — and
# the conversation is saved to disk, so after a restart resume with:  ct --continue
#
# Usage:
#   cd ~/workspaces/<repo>          # or ~/dev/<session>[/<repo>] — anywhere inside
#   ct                              # start here, or reattach if already running
#   ct --continue                   # (first launch only) resume the last conversation
#   Detach, leave it running:       Ctrl-b  then  d
#   List running sessions:          tmux ls
#   Reattach explicitly:            tmux attach -t =<name>     # '=' means exact
#
# Agents. CT_AGENT picks which coding agent the session runs: claude (default) or
# opencode. Each agent gets its own session, <agent>-<workspace>, so one
# workspace can run both side by side. Every opencode session is a terminal
# attached to ONE opencode server per machine (loopback, CT_OPENCODE_SERVER_PORT,
# default 4096), which ct starts on first use and keeps running. One server is
# one address for every workspace's sessions: a second terminal joins with
# `opencode attach`, a browser through an authenticating proxy (CT_OPENCODE_WEB).
# ct records each agent it launches, so ct-autostart can bring that agent back
# after a pod restart. To stop autostarting an agent in a workspace:
#   CT_AGENT=<agent> CT_AGENT_FORGET=1 ct
set -euo pipefail

agent="${CT_AGENT:-claude}"
case "$agent" in
  claude|opencode) ;;
  *) echo "ct: unknown CT_AGENT '$agent' (expected claude or opencode)" >&2; exit 2 ;;
esac

# A workspace is one directory directly under a workspace root: ~/dev/<session>
# for multi-repo agent sessions, ~/workspaces/<repo> for the curated clones this
# pod checks out on boot. Set CT_WORKSPACE_ROOT to override with a single root.
if [[ -n "${CT_WORKSPACE_ROOT:-}" ]]; then
  ws_roots=("$CT_WORKSPACE_ROOT")
else
  ws_roots=("$HOME/dev" "$HOME/workspaces")
fi

# tmux lives in the ephemeral container layer; self-heal after a pod restart.
if ! command -v tmux >/dev/null 2>&1; then
  echo "ct: tmux missing (pod was restarted) — installing once..." >&2
  sudo apt-get update -qq && sudo apt-get install -y -qq tmux
fi

# Session identity = the workspace directory. Under no root there is no workspace
# to name it after, so fall back to the current directory.
workspace="$PWD"
in_root=0
for root in "${ws_roots[@]}"; do
  if [[ "$PWD" == "$root"/* ]]; then
    rel="${PWD#"$root"/}"
    workspace="$root/${rel%%/*}"
    in_root=1
    break
  fi
done

# What the agent is told about where it is (docs/workspace-conventions.md, "Add a
# repo"): its workspace, and the root holding .gitcache/, .env and .kubeconfig.
# Exported into every session, so the recipe's commands run as written. Taken
# here, before a pinned session swaps  for its own directory: a pinned
# conversation in a worktree still belongs to the workspace that holds it.
agent_ws="$workspace"
agent_root="${agent_ws%/*}"

# --- the workspace's own environment ---
#
# No login is the machine's (docs/workspace-conventions.md, "Logins belong to a
# workspace or a profile"): two workspaces may work as two different Google
# accounts, and a login in ~/.config is every agent's at once. So a workspace
# under a root gets an .envrc at its first launch — written once, never
# overwritten, so the workspace can add its own — and the agent starts through
# `direnv exec` on it, which gives everything it runs, MCP servers included,
# that environment. A clone's .envrc inherits it with `source_up_if_exists`.
#
# Where the logins live: by default in the workspace itself, deleted with it.
# CT_PROFILE=<name> at the first launch makes it share a named profile instead,
# <root>/.profiles/<name>/, with every workspace that names the same one — one
# sign-in serving, say, every workspace of one company.
if [[ -n ${CT_PROFILE:-} && ! ${CT_PROFILE} =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "ct: CT_PROFILE '$CT_PROFILE' is not a profile name ([a-z0-9-])" >&2; exit 2
fi
ws_envrc_write() {
  local f="$agent_ws/.envrc"
  ((in_root)) || return 0
  [[ -e $f ]] && return 0
  {
    cat <<'EOF'
# This workspace's own environment. ct wrote it at the first launch and never
# overwrites it, so edit it freely (and run `direnv allow` here afterwards). ct
# starts the agent through `direnv exec` on this file, and a clone's .envrc that
# begins with `source_up_if_exists` inherits it.
#
# Whose logins this workspace uses — never the machine's. Empty: its own, kept
# in the workspace and deleted with it. A name: a profile shared by every
# workspace that names it (one sign-in serves them all), kept beside the
# workspaces in .profiles/<name>/, so tearing one workspace down keeps it.
EOF
    printf 'ct_profile=%s\n' "${CT_PROFILE:-}"
    cat <<'EOF'
if [[ -n $ct_profile ]]; then logins="${PWD%/*}/.profiles/$ct_profile"; else logins="$PWD/.config"; fi
export CLOUDSDK_CONFIG="$logins/gcloud"   # gcloud, and its application-default credentials
# Go programs (OpenTofu's Google provider) ignore CLOUDSDK_CONFIG and look in ~/.config/gcloud.
export GOOGLE_APPLICATION_CREDENTIALS="$CLOUDSDK_CONFIG/application_default_credentials.json"

# Tools for the agent outside any clone, if this workspace has a flake of its own.
if [[ -f flake.nix ]]; then use flake; fi

source_env_if_exists .envrc.local
EOF
  } > "$f"
  if [[ -n ${CT_PROFILE:-} ]]; then echo "ct: wrote $f — logins: profile $CT_PROFILE" >&2
  else echo "ct: wrote $f — logins: this workspace's own" >&2; fi
  if command -v direnv >/dev/null 2>&1; then direnv allow "$agent_ws" >/dev/null 2>&1 || true; fi
}

# The prefix that starts a command inside the workspace's environment, or
# nothing. A blocked .envrc makes `direnv exec` refuse to run the command at all,
# which would take the agent down with it, so probe first and start without the
# environment — loudly — rather than not at all.
ws_exec_prefix() {
  ((in_root)) || return 0
  [[ -f "$agent_ws/.envrc" ]] || return 0
  command -v direnv >/dev/null 2>&1 || { echo "ct: no direnv — starting without $agent_ws/.envrc" >&2; return 0; }
  if direnv exec "$agent_ws" true >/dev/null 2>&1; then
    printf "direnv exec %q " "$agent_ws"
  else
    echo "ct: WARNING: $agent_ws/.envrc is blocked (run: direnv allow $agent_ws) — starting WITHOUT the workspace's environment, so its logins fall back to the machine's" >&2
  fi
}

# --- pinned sessions: one conversation, kept alive by id, outside any workspace ---
#
# A workspace has ONE claude agent, so a second conversation that belongs to it —
# a fork, an agent working in a worktree — has nowhere to live: a pod restart ends
# it and nothing brings it back. CT_SESSION_ID + CT_NAME pin that conversation:
# run from the directory it was started in (Claude keys a conversation on that
# directory, so `--resume` from anywhere else does not find it), and ct resumes
# exactly that id under the name, records it, and ct-autostart revives it like a
# workspace agent.
pinned=""
if [[ -n "${CT_SESSION_ID:-}" ]]; then
  if [[ $agent != claude ]]; then
    echo "ct: CT_SESSION_ID resumes a claude conversation; it does not apply to CT_AGENT=$agent" >&2; exit 2
  fi
  if [[ -z "${CT_NAME:-}" ]]; then
    echo "ct: CT_SESSION_ID needs CT_NAME, the name to run it under" >&2; exit 2
  fi
  if [[ ! $CT_NAME =~ ^[A-Za-z0-9_.-]+$ || ! $CT_SESSION_ID =~ ^[A-Za-z0-9-]+$ ]]; then
    echo "ct: CT_NAME may hold letters, digits, '.', '_' and '-'; CT_SESSION_ID is a session uuid" >&2; exit 2
  fi
  pinned="$CT_SESSION_ID"
  workspace="$PWD"
fi

# printf, not `basename`: basename emits a trailing newline, which this tr (a
# COMPLEMENT class — every character outside the set is replaced) turned into a
# stray '-' on the end of every session name.
# The name a person knows it by: the pinned session's own, else the workspace's.
if [[ -n $pinned ]]; then display="$CT_NAME"; else display="${workspace##*/}"; fi
base="$(printf '%s' "$display" | tr -c 'A-Za-z0-9_-' '-')"
name="$agent-$base"

# Where Claude keeps a directory's transcripts: ~/.claude/projects/<key>, where
# the key is the absolute path with EVERY character that is not a letter or a
# digit turned into '-' (so `/a/.claude/b c` is `-a--claude-b-c`). Replacing
# only '/' — what ct did before 0.5.0 — misses any path with a dot or a space,
# and then nothing resumes. The keys START WITH A HYPHEN: ls/find/stat parse
# that as an option, so they are only ever used in quoted paths and globs.
transcripts() { printf '%s/.claude/projects/%s' "$HOME" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '-')"; }

# glob_any, not `compgen -G`: compgen exists only when bash was built with
# programmable completion. Fedora 43's bash has none, so there ct_pick_session
# failed silently and EVERY session started empty instead of resuming. The
# directory is quoted (spaces are safe) and only the pattern expands.
glob_any() { local f; for f in "$1"/$2; do [[ -e $f || -L $f ]] && return 0; done; return 1; }

# --- agent record: which agents ct-autostart brings back for this workspace ---
#
# One file per workspace, one line per agent: "claude" or "opencode". (Before
# 0.7.0 an opencode line also carried its own port, "opencode <port>"; such a
# line is read as plain "opencode".)
# On disk, not in tmux options, because those die with the pod and the record
# is exactly what has to survive it. NO file means "claude" — what every
# workspace meant before agents existed — so upgrading ct changes nothing for
# workspaces that never ran another agent. An EMPTY file means "nothing".
records="${CT_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ct}/agents"
record="$records/$base"
# Pinned sessions have their own records: "claude <session-id> <name> <dir>",
# one file each, so a workspace's record never lists a conversation from
# somewhere else.
pins="${CT_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ct}/sessions"

record_line() { # agent -> its line, if recorded
  [[ -f $record ]] || return 1
  awk -v a="$1" '$1 == a { print; found = 1; exit } END { exit !found }' "$record"
}

# A Claude agent that predates the record: its transcript, or its session.
claude_evidence() {
  glob_any "$(transcripts "$workspace")" '*.jsonl' ||
    tmux has-session -t "=claude-$base" 2>/dev/null
}

record_add() { # line
  record_line "${1%% *}" >/dev/null && return 0
  mkdir -p "$records"
  # Creating the record for a workspace whose Claude agent predates it: write
  # claude in too. Otherwise the first opencode launch would turn "no file =
  # claude" into "opencode only", and the Claude agent would silently stop
  # coming back after the next pod restart.
  if [[ ! -f $record && $agent != claude ]] && claude_evidence; then
    echo claude >> "$record"
  fi
  echo "$1" >> "$record"
}

if [[ -n "${CT_AGENT_FORGET:-}" && -n $pinned ]]; then
  rm -f "$pins/$base"
  echo "ct: $CT_NAME: ct-autostart will no longer start this pinned session (a running one is left alone)" >&2
  exit 0
fi

if [[ -n "${CT_AGENT_FORGET:-}" ]]; then
  if [[ ! -f $record ]]; then
    mkdir -p "$records"
    # No file meant "claude"; keep every other agent's meaning by writing
    # exactly that out before taking this one away.
    if [[ $agent == claude ]] || claude_evidence; then echo claude > "$record"; else : > "$record"; fi
  fi
  awk -v a="$agent" '$1 != a' "$record" > "$record.tmp" && mv "$record.tmp" "$record"
  echo "ct: $base: ct-autostart will no longer start $agent here (a running session is left alone)" >&2
  exit 0
fi

# --- opencode: one server per machine, one attached terminal per workspace ---
#
# Until 0.7.0 every workspace's TUI served its own API on its own port, so each
# workspace had its own web address. One server gives one address for all of
# them, and its web UI lists every workspace. The cost: a server restart drops
# every attached terminal at once (ct-autostart brings them back), and the
# agents' shells no longer carry CT_WORKSPACE — they run in the workspace
# directory, which is what the conventions' recipe falls back to.
oc_port="${CT_OPENCODE_SERVER_PORT:-4096}"
oc_url="http://127.0.0.1:$oc_port"
oc_session="ct-opencode-server"   # not opencode-*: that is a workspace's name
ct_self="$(readlink -f "${BASH_SOURCE[0]}")"

oc_healthy() { curl -fsS -m 3 "$oc_url/global/health" 2>/dev/null | grep -q '"healthy":true'; }

# Start the server in its own tmux session, in a loop so a crash restarts it,
# then wait until it answers. Loopback only: the way in from outside is an
# authenticating proxy, never an open port.
#
# After a RESTART the loop reopens every terminal attached to this server
# (CT_OPENCODE_REFRESH, below): a terminal outlives its server's restart, still
# sends what is typed, but never shows another reply (seen live, 1.18.35), and
# nothing else would notice — the server answers its health check.
opencode_server() {
  local i
  command -v curl >/dev/null 2>&1 || { echo "ct: opencode needs curl, to reach its server" >&2; return 1; }
  oc_healthy && return 0
  if ! tmux has-session -t "=$oc_session" 2>/dev/null; then
    tmux new-session -d -s "$oc_session" -c "$HOME" \
      "n=0; while :; do if [ \$n -gt 0 ]; then (CT_OPENCODE_SERVER_PORT=$oc_port CT_OPENCODE_REFRESH=1 $(printf '%q' "$ct_self") &); fi; n=\$((n + 1)); opencode serve --port $oc_port --hostname 127.0.0.1; echo 'ct: opencode server exited; restarting in 2 s'; sleep 2; done"
    echo "ct: started the opencode server on 127.0.0.1:$oc_port (tmux session '$oc_session')" >&2
  fi
  for ((i = 0; i < ${CT_OPENCODE_SERVER_WAIT:-60}; i++)); do
    oc_healthy && return 0
    sleep 1
  done
  echo "ct: the opencode server on 127.0.0.1:$oc_port does not answer (see: tmux attach -t '=$oc_session')" >&2
  return 1
}

# Percent-encoding for a query value, by hand: curl's --get would also turn a
# POST body into a query string, and --url-query needs curl 7.87.
urlencode() { # text -> encoded
  local LC_ALL=C s="$1" out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case "$c" in [A-Za-z0-9._~/-]) out+="$c" ;; *) out+=$(printf '%%%02X' "'$c") ;; esac
  done
  printf '%s' "$out"
}

# The workspace's most recent session id, from the server (newest first). Not
# `attach --continue`: on a shared server that means the most recent session of
# ANY workspace.
oc_last_session() { # dir -> id on stdout, or nothing
  curl -fsS -m 10 "$oc_url/session?directory=$(urlencode "$1")" 2>/dev/null |
    grep -o '"id":"ses_[A-Za-z0-9]*"' | head -1 | cut -d'"' -f4
}

json_string() { # text -> a JSON string literal
  local s="$1"
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

# Send the wake message into the session before the terminal attaches; `attach`
# has no prompt option. The session's own model answers it.
oc_wake() { # dir session text
  curl -fsS -m 10 -o /dev/null -X POST -H 'content-type: application/json' \
    --data-binary "{\"parts\":[{\"type\":\"text\",\"text\":$(json_string "$3")}]}" \
    "$oc_url/session/$2/prompt_async?directory=$(urlencode "$1")" 2>/dev/null ||
    echo "ct: could not send the wake message to $2 (continuing)" >&2
}

opencode_access() { # how to reach the server, on stderr
  echo "ct: opencode server on 127.0.0.1:$oc_port — join this workspace with: opencode attach $oc_url --dir $workspace" >&2
  if [[ -n "${CT_OPENCODE_WEB:-}" ]]; then
    echo "ct: opencode web: ${CT_OPENCODE_WEB//\{port\}/$oc_port}" >&2
  fi
}

# CT_OPENCODE_REFRESH=1: reopen every terminal attached to THIS server, each on
# the session it showed (ct resumes the workspace's last one). Run by the server
# loop after a restart. A pre-0.7.0 terminal, which is its own server on another
# port, is left alone.
if [[ -n "${CT_OPENCODE_REFRESH:-}" ]]; then
  while IFS= read -r s; do
    [[ $(tmux show-option -qv -t "$s" @ct_agent 2>/dev/null) == opencode ]] || continue
    [[ $(tmux show-option -qv -t "$s" @ct_port 2>/dev/null) == "$oc_port" ]] || continue
    ws="$(tmux show-option -qv -t "$s" @ct_workspace 2>/dev/null)"
    [[ -n $ws && -d $ws ]] || continue
    tmux kill-session -t "=$s"
    ( cd "$ws" && env -u CT_OPENCODE_REFRESH -u CT_WAKE_SINCE CT_AGENT=opencode CT_DETACH=1 "$ct_self" ) ||
      echo "ct: could not reopen $s" >&2
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  exit 0
fi

# One-time migration off the old trailing-dash names, so a session started by the
# previous version of this script is adopted instead of orphaned. Only the exact
# workspace-plus-dash form is claimed; old per-repo names (e.g. claude-myrepo-)
# are deliberately left alone because they are ambiguous across workspaces.
# Claude only: the trailing-dash names predate every other agent.
if [[ $agent == claude ]] && ! tmux has-session -t "=$name" 2>/dev/null && tmux has-session -t "=$name-" 2>/dev/null; then
  tmux rename-session -t "=$name-" "$name"
  echo "ct: adopted legacy session '$name-' as '$name'" >&2
fi

if tmux has-session -t "=$name" 2>/dev/null; then
  # '=' forces an EXACT match. Without it tmux falls back to prefix matching, so
  # `ct` in agent-truckbed would attach to the agent running in agent-truckbed-2.
  # Only has-session/attach-session accept '='; show-option and set-option reject
  # it outright ("no such session") and take the bare name, which is safe here
  # because the exact-match check above has already run.
  session_ws="$(tmux show-option -qv -t "$name" @ct_workspace 2>/dev/null || true)"
  if [[ -n "$session_ws" && "$session_ws" != "$workspace" ]]; then
    echo "ct: refusing to attach — session '$name' belongs to $session_ws, not $workspace" >&2
    echo "ct: rename one of the workspaces, or attach deliberately with: tmux attach -t '=$name'" >&2
    exit 1
  fi
  if (($#)); then
    echo "ct: '$name' is already running — arguments ($*) apply only at first launch, ignoring" >&2
  fi
  origin="$(tmux show-option -qv -t "$name" @ct_origin 2>/dev/null || true)"
  if [[ $agent == opencode ]]; then
    opencode_access
  fi
  if [[ -n "${CT_DETACH:-}" ]]; then
    echo "ct: '$name' already running${origin:+ (started in $origin)} — detached, not attaching" >&2
    exit 0
  fi
  echo "ct: attaching to '$name'${origin:+ (started in $origin)}" >&2
  exec tmux attach-session -t "=$name"
fi

# --- the wake message: what an agent is told when ct-autostart brings it back ---
#
# Waking an agent with no word leaves it sitting on an empty prompt, unaware that
# every background shell, watcher and port-forward it had died with it — and a
# conversation that ended mid-wait ("I'll check when CI finishes") never picks up.
# So a resumed agent's first message says what happened and what to do.
#
# Sent only when ct-autostart asks (CT_WAKE_SINCE = when this machine or
# container started, epoch seconds) and only on a RESUMED conversation: a
# fresh session has nothing to re-check, and a person running `ct` is right
# there to say it themselves. CT_WAKE=0 switches it off; ~/.config/ct/wake.md
# (or CT_WAKE_FILE) replaces the text, with {event}, {time} and {gap}.
ct_human_gap() { # seconds -> "2 h 5 min"
  local s=$1
  if ((s < 120)); then echo "$s s"
  elif ((s < 7200)); then echo "$((s / 60)) min"
  elif ((s < 172800)); then echo "$((s / 3600)) h $((s % 3600 / 60)) min"
  else echo "$((s / 86400)) days"; fi
}

wake_text() { # last-activity epoch, or "" if unknown -> the message on stdout, or nothing
  local last="$1" since="${CT_WAKE_SINCE:-}" now event gap tpl file
  [[ -n $since && "${CT_WAKE:-1}" != 0 ]] || return 1
  now=$(date +%s)
  if [[ -n $last ]]; then
    # It was alive when this machine started: the restart is what ended it.
    if ((last < since)); then event="this machine restarted"
    else event="your session had ended, and ct-autostart started it again"; fi
    gap="Your last activity was $(ct_human_gap $((now - last))) ago."
  else
    # No activity time to compare (opencode keeps one store for everything):
    # a wake soon after the machine started is that start; later, it is not.
    if ((now - since < ${CT_WAKE_BOOT_WINDOW:-1800})); then event="this machine restarted"
    else event="your session had ended, and ct-autostart started it again"; fi
    gap=""
  fi
  file="${CT_WAKE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/ct/wake.md}"
  if [[ -r $file ]]; then
    tpl=$(cat "$file")
  else
    tpl="ct: {event} ({time}). {gap} Your conversation is intact, but everything that lived in processes is gone: background shells and the watchers in them, port-forwards, anything you had running beside this session. Check the state of what you were in the middle of — git status, CI runs or deploys in flight — and re-establish what you need. Tell the user in one or two lines where you stand, then continue only work the user had already approved. Do not start anything new."
  fi
  tpl=${tpl//\{event\}/$event}
  tpl=${tpl//\{time\}/$(date '+%Y-%m-%d %H:%M %Z')}
  # An unknown gap leaves no gap: drop the placeholder with its trailing space.
  [[ -z $gap ]] && tpl=${tpl//\{gap\} /}
  tpl=${tpl//\{gap\}/$gap}
  printf '%s' "$tpl"
}

# Quote arguments individually; the previous "claude ${*:-}" form word-split any
# argument containing spaces.
if [[ $agent == opencode ]]; then
  opencode_server
  cmd="opencode attach $oc_url --dir $(printf '%q' "$workspace")"
  # Resume by default, as for claude: this workspace's most recent session,
  # chosen by id. With none, the terminal opens fresh. The caller's own session
  # choice wins.
  resuming=0
  for a in "$@"; do
    case "$a" in -c|--continue|-s|--session|--session=*|--fork) resuming=1 ;; esac
  done
  if ((resuming == 0)) && [[ -z "${CT_FRESH:-}" ]]; then
    sid="$(oc_last_session "$workspace")" || sid=""
    if [[ -n $sid ]]; then
      cmd+=" --session $sid"
      echo "ct: resuming $sid (CT_FRESH=1 for a new session)" >&2
      if wake="$(wake_text "")"; then
        oc_wake "$workspace" "$sid" "$wake"
      fi
    fi
  fi
  if (($#)); then
    cmd+=" $(printf '%q ' "$@")"
  fi
  record_add opencode
  tmux new-session -d -s "$name" -c "$workspace" \
    -e "CT_WORKSPACE=$agent_ws" -e "WORKSPACE_ROOT=$agent_root" "$cmd"
  tmux set-option -t "$name" @ct_workspace "$workspace" >/dev/null
  tmux set-option -t "$name" @ct_origin "$PWD" >/dev/null
  tmux set-option -t "$name" @ct_agent "$agent" >/dev/null
  tmux set-option -t "$name" @ct_port "$oc_port" >/dev/null
  opencode_access
  if [[ -n "${CT_DETACH:-}" ]]; then
    echo "ct: started '$name' detached (attach with: tmux attach -t '=$name')" >&2
    exit 0
  fi
  exec tmux attach-session -t "=$name"
fi

cmd="claude"

# Resume the workspace's conversation by DEFAULT. Starting fresh is what people
# almost never mean after the session died — and it dies for mundane reasons: a
# claude auto-update, a crash, /exit. The pane's command ends, tmux drops the
# session, and the next `ct` used to open an empty conversation on top of a
# perfectly good transcript. (Observed 2026-09-11: an auto-update to 2.1.268
# ended agent-llm's session; the following `ct` started blank.)
#
# Pick by ID, not `--continue`. `--continue` means "most recent in this
# directory", so one accidental fresh session becomes the most recent and every
# later resume — including the one ct-autostart does after a reboot — silently
# lands on the stub instead of the real history. Choose the most recent
# transcript with real content and resume it explicitly.
#
# Transcript dirs are the cwd with '/' turned into '-', so they START WITH A
# HYPHEN: ls/find/stat parse that as an option. Bash globs only.
#
ct_pick_session() {
  local dir="$1" min="${CT_MIN_LINES:-50}" key best=""
  key="$(transcripts "$dir")"
  glob_any "$key" '*.jsonl' || return 1
  # newest first; take the first one that is more than a stub
  while IFS= read -r f; do
    if [[ $(wc -l < "$f") -ge $min ]]; then best="$f"; break; fi
  done < <(ls -t "$key"/*.jsonl 2>/dev/null)
  [[ -n "$best" ]] || return 1
  # the filename without .jsonl IS the session id `claude --resume` accepts
  basename "$best" .jsonl
}

resuming=0
for a in "$@"; do
  case "$a" in -c|--continue|-r|--resume|--resume=*|--fork-session) resuming=1 ;; esac
done
sid=""
if [[ -n $pinned ]]; then
  # The pinned id, from the directory it lives under — or a clear refusal, since
  # `claude --resume <id>` from the wrong directory just starts empty.
  if [[ ! -e "$(transcripts "$workspace")/$pinned.jsonl" ]]; then
    echo "ct: no conversation $pinned under $workspace — run this from the directory it was started in" >&2
    exit 1
  fi
  sid="$pinned"
elif ((resuming == 0)) && [[ -z "${CT_FRESH:-}" ]]; then
  sid="$(ct_pick_session "$workspace")" || sid=""
fi
if [[ -n $sid ]]; then
  cmd+=" --resume $(printf '%q' "$sid")"
  if [[ -n $pinned ]]; then echo "ct: resuming $sid as $CT_NAME" >&2
  else echo "ct: resuming $sid (CT_FRESH=1 for a new conversation)" >&2; fi
fi

# Name the CLAUDE session after the workspace as well. Without -n every session
# gets a random adjective-noun pair ("frolicking-prism"), which is what makes a
# dozen parallel workspaces indistinguishable in the prompt box, the /resume
# picker and the terminal title. An explicit -n/--name from the caller wins.
named=0
for a in "$@"; do
  case "$a" in -n|--name|--name=*) named=1 ;; esac
done
if ((named == 0)); then
  cmd+=" --name $(printf '%q' "$display")"
fi

if (($#)); then
  cmd+=" $(printf '%q ' "$@")"
fi

# The wake message is claude's initial prompt: a positional argument, so last.
if [[ -n $sid ]] && wake="$(wake_text "$(stat -c %Y "$(transcripts "$workspace")/$sid.jsonl" 2>/dev/null)")"; then
  cmd+=" $(printf '%q' "$wake")"
fi

# Start claude at the WORKSPACE root, never in $PWD. Claude keys its transcript
# folder on the directory it starts in, and ct_pick_session looks the resume id
# up under the workspace root. Starting in $PWD meant a `ct` run from inside a
# repo clone wrote its transcript under the repo path while resuming from the
# workspace path: two keys for one agent, and the next resume missing the
# conversation. One start directory gives one key. @ct_origin still records
# where ct was run, for the attach message.
if [[ -n $pinned ]]; then
  mkdir -p "$pins"
  printf 'claude %s %s %s\n' "$pinned" "$CT_NAME" "$workspace" > "$pins/$base"
else
  record_add claude
fi
ws_envrc_write
cmd="$(ws_exec_prefix)$cmd"
tmux new-session -d -s "$name" -c "$workspace" \
  -e "CT_WORKSPACE=$agent_ws" -e "WORKSPACE_ROOT=$agent_root" "$cmd"
tmux set-option -t "$name" @ct_workspace "$workspace" >/dev/null
tmux set-option -t "$name" @ct_origin "$PWD" >/dev/null
tmux set-option -t "$name" @ct_agent "$agent" >/dev/null

# CT_DETACH=1: create the session and return, instead of attaching. This is
# what lets a boot script call ct — `tmux attach` needs a controlling TTY and
# the pod's PID 1 has none (no TERM in its environ at all).
#
# An env var, deliberately not a flag: unrecognised arguments are forwarded
# verbatim to claude below, and `-d` there means --debug. `ct -d` would land
# `claude --name X -d --continue` on the command line and claude would reject
# it — which, with remain-on-exit off, closes the pane and destroys the
# evidence.
if [[ -n "${CT_DETACH:-}" ]]; then
  echo "ct: started '$name' detached (attach with: tmux attach -t '=$name')" >&2
  exit 0
fi
exec tmux attach-session -t "=$name"
